# package-ci.yml (viewer-workflows) configures actions/setup-node with
# registry-url=npm.pkg.github.com and scope=@metanull — needed so github.token
# can install the @metanull/*-data packages the downstream website matrix
# still depends on (see ci.yml). That makes npm.pkg.github.com the *default*
# registry for every other scope too, including this package's own
# @museumwnf/viewer-core dependency, which is only ever published to npmjs.
#
# This project-level .npmrc takes precedence over the user-level one
# actions/setup-node writes, for the @museumwnf scope specifically, so
# `npm ci` here resolves @museumwnf/* from npmjs regardless of the CI
# default. Remove once package-ci.yml stops assuming @metanull (tracked
# against viewer-workflows, not this repo).
@museumwnf:registry=https://registry.npmjs.org/
